# Amaya CRM (Next.js + MongoDB)

# MongoDB connection string (MongoDB Atlas recommended). Leave empty in development to use a
# local in-memory MongoDB that is persisted to ./.data (never used in production).
MONGODB_URI=""
MONGODB_DB="amaya_crm"

# Public base URL of the deployment (used to build webhook URLs shown in Settings)
APP_URL="http://localhost:3000"

# Protects /api/cron/* (Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=""

# Encrypts API keys saved from Settings → Integrations (32+ random characters).
# Integration keys may instead be set directly here and then take precedence:
SECRETS_ENCRYPTION_KEY=""
GEMINI_API_KEY=""
CHAT360_API_KEY=""
CHAT360_WEBHOOK_SECRET=""
TELEPHONY_WEBHOOK_SECRET=""

# Optional SMTP for the daily digest e-mail
SMTP_URL=""
MAIL_FROM=""

# Multi-company platform: name of the platform database (company registry, super admins, user directory);
# empty = "amaya_platform".
# Each company gets its own database (crm_<slug>); MONGODB_DB is only the pre-platform single-company database.
PLATFORM_DB=""
# One-time token for the first super admin set up from the web (/superadmin). REQUIRED in production for
# web setup; leave empty and use `npm run create-superadmin` instead to keep web setup disabled there.
PLATFORM_SETUP_TOKEN=""
